#!/usr/bin/env bash

set -uo pipefail

readonly APP_ID="caelestia-vault"
readonly KEY_ATTR="application"
readonly KEY_VALUE="caelestia-vault"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/caelestia-vault"
readonly ITEMS_CACHE="$RUNTIME_DIR/items.json"
readonly VAULT_CACHE="$RUNTIME_DIR/vault.enc"
readonly CACHE_KEY_VALUE="caelestia-vault-cache"

json_error() {
    jq -cn --arg error "$1" '{error: $error}'
}

stored_session() {
    secret-tool lookup "$KEY_ATTR" "$KEY_VALUE" 2>/dev/null || true
}

clear_cache() {
    rm -f -- "$ITEMS_CACHE" "$VAULT_CACHE"
    secret-tool clear "$KEY_ATTR" "$CACHE_KEY_VALUE" >/dev/null 2>&1 || true
}

cache_key() {
    secret-tool lookup "$KEY_ATTR" "$CACHE_KEY_VALUE" 2>/dev/null || true
}

store_vault_cache() {
    local vault_json="$1" key cache_tmp
    key="$(cache_key)"
    if [[ -z "$key" ]]; then
        key="$(openssl rand -hex 32)"
        printf '%s' "$key" | secret-tool store --label="Caelestia Vault - temporary cache key" "$KEY_ATTR" "$CACHE_KEY_VALUE"
    fi

    umask 077
    mkdir -p -- "$RUNTIME_DIR"
    chmod 700 -- "$RUNTIME_DIR"
    cache_tmp="$VAULT_CACHE.$$"
    if printf '%s' "$vault_json" | openssl enc -aes-256-cbc -pbkdf2 -iter 10000 -salt -pass fd:3 3<<<"$key" -out "$cache_tmp"; then
        chmod 600 -- "$cache_tmp"
        mv -f -- "$cache_tmp" "$VAULT_CACHE"
    else
        rm -f -- "$cache_tmp"
        unset key
        return 1
    fi
    unset key
}

cached_field() {
    local id="$1" filter="$2" key
    key="$(cache_key)"
    [[ -n "$key" && -s "$VAULT_CACHE" ]] || return 1
    openssl enc -d -aes-256-cbc -pbkdf2 -iter 10000 -pass fd:3 3<<<"$key" -in "$VAULT_CACHE" 2>/dev/null \
        | jq -er --arg id "$id" "first(.[] | select(.id == \$id)) | $filter"
    local result=$?
    unset key
    return "$result"
}

get_session() {
    local session
    session="$(stored_session)"
    if [[ -n "$session" ]]; then
        printf '%s' "$session"
        return 0
    fi
    return 1
}

notify() {
    notify-send -a "Caelestia Vault" -i password-manager "$1" "${2:-}" >/dev/null 2>&1 || true
}

open_terminal() {
    local action="$1"
    if command -v foot >/dev/null 2>&1; then
        foot --app-id="$APP_ID" --title="Caelestia - Bitwarden" "$0" "$action" >/dev/null 2>&1 &
    elif command -v kitty >/dev/null 2>&1; then
        kitty --class "$APP_ID" --title "Caelestia - Bitwarden" "$0" "$action" >/dev/null 2>&1 &
    else
        json_error "No supported terminal found (foot or kitty)"
        return 1
    fi
}

status() {
    if ! command -v bw >/dev/null 2>&1; then
        jq -cn '{status: "missing", userEmail: "", serverUrl: ""}'
        return
    fi

    local session
    session="$(stored_session)"

    if [[ -n "$session" ]]; then
        jq -cn '{status: "unlocked", userEmail: "", serverUrl: ""}'
    else
        clear_cache
        jq -cn '{status: "locked", userEmail: "", serverUrl: ""}'
    fi
}

unlock_interactive() {
    clear
    printf '\n  Caelestia Vault - Bitwarden\n\n'

    if ! command -v bw >/dev/null 2>&1; then
        printf 'Bitwarden CLI is not installed.\n'
        read -r -p 'Press Enter to close...'
        exit 1
    fi

    local state session
    state="$(bw status 2>/dev/null | jq -r '.status // "unauthenticated"')"
    if [[ "$state" == "unauthenticated" ]]; then
        printf 'Sign in to Bitwarden. The widget never stores your master password.\n\n'
        session="$(bw login --raw)" || {
            printf '\nSign-in failed or was cancelled.\n'
            sleep 2
            exit 1
        }
    else
        printf '\nUnlock the vault for this session:\n\n'
        session="$(bw unlock --raw)" || {
            printf '\nCould not unlock the vault.\n'
            sleep 2
            exit 1
        }
    fi

    if [[ -z "$session" ]]; then
        printf '\nBitwarden did not return a session.\n'
        sleep 2
        exit 1
    fi

    printf '%s' "$session" | secret-tool store --label="Caelestia Vault - Bitwarden session" "$KEY_ATTR" "$KEY_VALUE"
    clear_cache
    unset session
    notify "Vault unlocked" "Your logins are available in the dashboard."
    printf '\nSession saved to GNOME Keyring.\nThis window will close automatically.\n'
    sleep 2
}

list_items() {
    local refresh="${1:-}" session output vault_json cache_tmp
    if ! session="$(get_session)"; then
        json_error "Vault is locked"
        return 3
    fi

    if [[ "$refresh" != "--refresh" && -s "$ITEMS_CACHE" ]]; then
        cat -- "$ITEMS_CACHE"
        return 0
    fi

    if ! vault_json="$(BW_SESSION="$session" bw list items 2>/dev/null)"; then
        secret-tool clear "$KEY_ATTR" "$KEY_VALUE" >/dev/null 2>&1 || true
        clear_cache
        json_error "Session expired; connect again"
        return 4
    fi
    if ! output="$(jq -c '
        [ .[] | select(.type == 1) | {
            id,
            name,
            type,
            username: (.login.username // ""),
            uri: (.login.uris[0].uri // ""),
            hasPassword: ((.login.password // "") != ""),
            hasTotp: ((.login.totp // "") != ""),
            passkeys: (.login.fido2Credentials // [] | length)
        } ] | sort_by(.name | ascii_downcase)' <<<"$vault_json")"; then
        secret-tool clear "$KEY_ATTR" "$KEY_VALUE" >/dev/null 2>&1 || true
        clear_cache
        json_error "Session expired; connect again"
        return 4
    fi
    store_vault_cache "$vault_json" || true
    unset vault_json
    umask 077
    mkdir -p -- "$RUNTIME_DIR"
    chmod 700 -- "$RUNTIME_DIR"
    cache_tmp="$ITEMS_CACHE.$$"
    printf '%s\n' "$output" >"$cache_tmp"
    chmod 600 -- "$cache_tmp"
    mv -f -- "$cache_tmp" "$ITEMS_CACHE"
    printf '%s\n' "$output"
}

copy_secret() {
    local kind="$1" id="$2" session value
    if ! session="$(get_session)"; then
        json_error "Vault is locked"
        return 3
    fi

    case "$kind" in
        username)
            value="$(cached_field "$id" '.login.username // empty')" \
                || value="$(BW_SESSION="$session" bw get item "$id" 2>/dev/null | jq -r '.login.username // empty')"
            ;;
        password)
            value="$(cached_field "$id" '.login.password // empty')" \
                || value="$(BW_SESSION="$session" bw get password "$id" 2>/dev/null)"
            ;;
        totp)
            value="$(BW_SESSION="$session" bw get totp "$id" 2>/dev/null)"
            ;;
        *)
            json_error "Invalid copy action"
            return 2
            ;;
    esac

    if [[ -z "$value" ]]; then
        json_error "This item does not contain that field"
        return 4
    fi

    printf '%s' "$value" | wl-copy --foreground --sensitive >/dev/null 2>&1 &
    local clipboard_pid
    clipboard_pid=$!
    (sleep 30; kill "$clipboard_pid" >/dev/null 2>&1 || true) >/dev/null 2>&1 &
    unset value
    notify "Copied for 30 seconds" "Paste normally with Ctrl+V."
    jq -cn --arg copied "$kind" '{ok: true, copied: $copied}'
}

open_item_uri() {
    local id="$1" session uri
    if ! session="$(get_session)"; then
        json_error "Vault is locked"
        return 3
    fi
    uri="$(cached_field "$id" '.login.uris[0].uri // empty')" \
        || uri="$(BW_SESSION="$session" bw get item "$id" 2>/dev/null | jq -r '.login.uris[0].uri // empty')"
    case "$uri" in
        http://*|https://*) xdg-open "$uri" >/dev/null 2>&1 & ;;
        *)
            json_error "This item does not have an HTTP(S) URL"
            return 4
            ;;
    esac
    jq -cn '{ok: true}'
}

sync_vault() {
    local session
    if ! session="$(get_session)"; then
        json_error "Vault is locked"
        return 3
    fi
    if BW_SESSION="$session" bw sync >/dev/null 2>&1; then
        clear_cache
        notify "Vault synced"
        jq -cn '{ok: true}'
    else
        json_error "Sync failed"
        return 4
    fi
}

lock_vault() {
    secret-tool clear "$KEY_ATTR" "$KEY_VALUE" >/dev/null 2>&1 || true
    clear_cache
    bw lock >/dev/null 2>&1 &
    wl-copy --clear >/dev/null 2>&1 || true
    notify "Vault locked"
    jq -cn '{ok: true}'
}

case "${1:-status}" in
    status) status ;;
    unlock) open_terminal unlock-interactive ;;
    unlock-interactive) unlock_interactive ;;
    list) list_items "${2:-}" ;;
    copy-username) copy_secret username "${2:-}" ;;
    copy-password) copy_secret password "${2:-}" ;;
    copy-totp) copy_secret totp "${2:-}" ;;
    open-uri) open_item_uri "${2:-}" ;;
    sync) sync_vault ;;
    lock) lock_vault ;;
    open-app)
        if command -v bitwarden >/dev/null 2>&1; then
            bitwarden >/dev/null 2>&1 &
        else
            xdg-open https://vault.bitwarden.com >/dev/null 2>&1 &
        fi
        ;;
    browser-extension) xdg-open https://bitwarden.com/download/ >/dev/null 2>&1 & ;;
    *) json_error "Unknown command"; exit 2 ;;
esac
